# =============================================================================
# PRODUCTION environment for docker-compose.yml
#   cp .env.example .env && chmod 600 .env
# Never commit .env. Never put real values in this example file.
# Local development uses apps/backend/.env and apps/frontend/.env.local instead
# (see docs/development-setup.md). Full reference: docs/deployment.md
# =============================================================================

# Release identifier shown in /health responses and used as the image tag (e.g. git SHA).
APP_VERSION=0.1.0

# --- PostgreSQL (internal only, never published) -----------------------------
POSTGRES_USER=ehans
# Generate with: openssl rand -hex 32   (hex keeps the DATABASE_URL URL-safe)
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_DB=ehans

# --- Backend -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (exact scheme + host, no trailing slash).
CORS_ORIGINS=https://example.com,https://www.example.com
# Reverse proxies in front of the backend (host Nginx = 1).
TRUST_PROXY=1
# Optional cookie domain for future auth cookies (e.g. .example.com to share with subdomains).
COOKIE_DOMAIN=
# Swagger UI at https://api.example.com/api/docs — keep false in production unless protected.
SWAGGER_ENABLED=false
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Frontend (PUBLIC: inlined into the browser bundle at build time) --------
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Host port bindings (always 127.0.0.1; Nginx proxies to these) -----------
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# --- Backups (infrastructure/scripts/backup-db.sh) ---------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Dev seed only (`pnpm db:seed`): creates the /admin store owner when both are set.
# Production: use `node dist/database/create-admin.js` instead (see docs/deployment.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
