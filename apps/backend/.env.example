# Local development environment for the backend (copy to apps/backend/.env).
# Production values are documented in the root .env.example and docs/deployment.md.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Matches docker-compose.dev.yml (local-only credentials, never use in production).
DATABASE_URL=postgresql://ehans:ehans_dev_password@localhost:5432/ehans_dev?schema=public

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the app (0 locally, 1 behind Nginx).
TRUST_PROXY=0

SWAGGER_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Where admin image uploads are stored (relative to apps/backend). Production: a Docker volume.
UPLOADS_DIR=storage/uploads

# BD Courier fraud check (bdcourier.com dashboard -> API key). Empty = the admin shows "Not set up".
BDCOURIER_API_KEY=
BDCOURIER_ENDPOINT=https://bdcourier.com/api/courier-check
# Hours a phone's result is reused before asking BD Courier again (saves API credit).
BDCOURIER_CACHE_HOURS=24

# Dev seed only (`pnpm db:seed`): creates the /admin store owner when both are set.
# Production: use `node dist/database/create-admin.js` instead (see docs/deployment.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
