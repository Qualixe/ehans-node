{
  "name": "@ehans/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API (modular monolith).",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "prisma generate && vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev && prisma generate",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma generate && nest build && node --enable-source-maps dist/database/seed/run-seed.js"
  },
  "dependencies": {
    "@ehans/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
