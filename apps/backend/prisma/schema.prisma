// Prisma schema — single source of truth for the database structure.
// Docs: docs/database-design.md
//
// Workflow:
//   development: pnpm db:migrate            (prisma migrate dev — creates + applies migrations)
//   production:  docker compose run --rm migrate   (prisma migrate deploy — applies committed migrations only)
// NEVER run `prisma migrate dev`, `migrate reset` or `db push` against production.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Catalog module (apps/backend/src/modules/catalog)
// Mirrors the glowy catalog schema; adds bundles + product relations used by the
// ehans-mart storefront design. Money columns are integer taka (BDT has no
// commonly used minor unit in this business; glowy stores whole taka too).
// =============================================================================

model Category {
  id              String   @id @default(uuid(7)) @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String
  slug            String   @unique
  homeTitle       String?  @map("home_title")
  image           String?
  description     String?
  position        Int      @default(0)
  showInMenu      Boolean  @default(true) @map("show_in_menu")
  homePosition    Int?     @map("home_position")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.VarChar(320)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    Product[]
  memberships ProductCategory[]

  @@index([parentId, position])
  @@index([homePosition])
  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid(7)) @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  name                 String
  slug                 String   @unique
  sku                  String   @unique
  brand                String?
  productType          String?  @map("product_type")
  /// Search keywords (e.g. English terms for Bangla product names).
  tags                 String[] @default([])
  shortDescription     String?  @map("short_description") @db.VarChar(500)
  /// Rich description (trusted HTML authored in the admin).
  description          String?
  /// [{ "label": "Brand", "value": "Mintiml" }, ...]
  specifications       Json?
  price                Int
  compareAtPrice       Int?     @map("compare_at_price")
  stock                Int      @default(0)
  soldCount            Int      @default(0) @map("sold_count")
  /// Denormalized from approved reviews (kept in sync by the reviews module).
  ratingAverage        Decimal? @map("rating_average") @db.Decimal(2, 1)
  ratingCount          Int      @default(0) @map("rating_count")
  isFeatured           Boolean  @default(false) @map("is_featured")
  /// Product page cross-sell headings (null = the template defaults).
  buyWithTitle         String?  @map("buy_with_title") @db.VarChar(120)
  upsellTitle          String?  @map("upsell_title") @db.VarChar(120)
  /// Show the Bundle & Save tiers (and apply their discounts) for this product.
  bundlesEnabled       Boolean  @default(true) @map("bundles_enabled")
  /// Show the variant dropdown; when off the product sells its default variant only.
  variantPickerEnabled Boolean  @default(true) @map("variant_picker_enabled")
  isActive             Boolean  @default(true) @map("is_active")
  metaTitle            String?  @map("meta_title")
  metaDescription      String?  @map("meta_description") @db.VarChar(320)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  bundles     ProductBundle[]
  relations   ProductRelation[] @relation("ProductRelationSource")
  relatedTo   ProductRelation[] @relation("ProductRelationTarget")
  /// Collection memberships (many-to-many, like Shopify collections). `categoryId` is the
  /// primary category (breadcrumbs); listings filter by membership.
  collections ProductCategory[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([isActive, categoryId, price])
  @@index([isActive, isFeatured])
  @@index([brand])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  path      String
  alt       String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String   @db.VarChar(60)
  position  Int      @default(1) @db.SmallInt
  values    String[]
  /// Optional { "<value>": "#hex" | "/image/path" } for swatch pickers.
  swatches  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_options")
}

model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  imageId        String?  @map("image_id") @db.Uuid
  title          String   @default("Default Title") @db.VarChar(200)
  option1        String?  @db.VarChar(100)
  option2        String?  @db.VarChar(100)
  option3        String?  @db.VarChar(100)
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  costPerItem    Int?     @map("cost_per_item")
  sku            String?  @db.VarChar(80)
  barcode        String?  @db.VarChar(80)
  stock          Int      @default(0)
  weightGrams    Int?     @map("weight_grams")
  position       Int      @default(1) @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([productId, position])
  @@index([sku])
  @@map("product_variants")
}

/// Product ↔ collection membership with a manual sort position (collection order).
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

/// "Bundle & Save" tiers on the product page (buy N, save X%).
model ProductBundle {
  id              String   @id @default(uuid(7)) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int      @db.SmallInt
  title           String   @db.VarChar(80)
  discountPercent Int      @default(0) @map("discount_percent") @db.SmallInt
  badge           String?  @db.VarChar(60)
  freeDelivery    Boolean  @default(false) @map("free_delivery")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, quantity])
  @@map("product_bundles")
}

enum ProductRelationType {
  BUY_WITH
  UPSELL

  @@map("product_relation_type")
}

/// Merchandising links: "Buy it with" checkboxes and "Complete your ..." upsells.
model ProductRelation {
  id               String              @id @default(uuid(7)) @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  position         Int                 @default(0) @db.SmallInt
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  product        Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relations")
}

/// Product reviews from the storefront; shown only after an admin approves them.
model Review {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  name       String
  email      String?
  rating     Int      @db.SmallInt
  body       String
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
  @@index([isApproved, createdAt])
  @@map("reviews")
}

// =============================================================================
// Auth module (apps/backend/src/modules/auth) — admin users and their sessions.
// Same model as glowy: the store owner has every permission; staff get a map of
// { section: "view" | "manage" } (see AdminSection in @ehans/shared).
// =============================================================================

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  email        String?   @unique
  phone        String?   @unique @db.VarChar(20)
  /// Storefront customers: default delivery address + district key (filled into checkout).
  address      String?   @db.VarChar(500)
  district     String?   @db.VarChar(40)
  passwordHash String    @map("password_hash")
  isAdmin      Boolean   @default(false) @map("is_admin")
  role         UserRole?
  /// { "orders": "manage", "products": "view", ... } — ignored for the owner.
  permissions  Json?
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  orders   Order[]

  assignedOrders   Order[]              @relation("OrderAssignee")
  createdOrders    Order[]              @relation("OrderCreator")
  orderNotes       OrderNote[]
  orderEvents      OrderEvent[]
  blockedContacts  BlockedContact[]
  handledCheckouts IncompleteCheckout[]

  @@map("users")
}

/// Admin sign-in sessions. Only a SHA-256 hash of the session token is stored.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// Orders (glowy's orders schema). Written by checkout / POS / admin (next slices);
// read by the admin dashboard now.
// =============================================================================

/// Order panel statuses. Cancelled, Returned and Fake put the stock back.
enum OrderStatus {
  PENDING
  CONFIRMED
  /// "Call not received"
  NO_ANSWER
  /// "Follow up"
  FOLLOW_UP
  /// "Ready for delivery" (packed)
  READY
  SHIPPED
  DELIVERED
  /// "Partial delivery"
  PARTIAL
  RETURNED
  /// "Fake order"
  FAKE
  CANCELLED

  @@map("order_status")
}

/// Marketing channel that brought the customer (first touch), or POS.
enum OrderChannel {
  ORGANIC
  SOCIAL
  DIRECT
  REFERRAL
  POS

  @@map("order_channel")
}

model Order {
  id               String       @id @default(uuid(7)) @db.Uuid
  number           String       @unique @db.VarChar(40)
  userId           String?      @map("user_id") @db.Uuid
  status           OrderStatus  @default(PENDING)
  customerName     String       @map("customer_name")
  /// "walk-in" for anonymous POS sales.
  phone            String       @db.VarChar(30)
  /// Second number to call (order panel "Alternative number").
  altPhone         String?      @map("alt_phone") @db.VarChar(20)
  email            String?
  address          String       @db.VarChar(500)
  city             String
  shippingZone     String       @map("shipping_zone")
  note             String?
  adminNote        String?      @map("admin_note")
  paymentMethod    String       @default("cod") @map("payment_method") @db.VarChar(30)
  paymentStatus    String?      @map("payment_status") @db.VarChar(20)
  paymentId        String?      @unique @map("payment_id") @db.VarChar(80)
  paymentAccount   String?      @map("payment_account") @db.VarChar(20)
  paymentReference String?      @map("payment_reference") @db.VarChar(40)
  channel          OrderChannel @default(DIRECT)
  /// Where the order came from: Website, Landing page, Facebook, Google, Instagram, TikTok,
  /// WhatsApp, Phone call, POS (order panel "source").
  source           String       @default("Website") @db.VarChar(30)
  /// Staff member handling the order (order panel "team"); null = unassigned.
  assignedToId     String?      @map("assigned_to_id") @db.Uuid
  /// Staff member who created it by hand (POS / phone / WhatsApp); null for web orders.
  createdById      String?      @map("created_by_id") @db.Uuid
  /// The incomplete checkout this order was recovered from.
  recoveredFromId  String?      @unique @map("recovered_from_id") @db.Uuid
  ipAddress        String?      @map("ip_address") @db.VarChar(45)
  courier          String?
  trackingNumber   String?      @map("tracking_number")
  courierService   String?      @map("courier_service")
  consignmentId    String?      @map("consignment_id")
  courierStatus    String?      @map("courier_status")
  courierFee       Int?         @map("courier_fee")
  codAmount        Int?         @map("cod_amount")
  courierSentAt    DateTime?    @map("courier_sent_at") @db.Timestamptz(3)
  courierSyncedAt  DateTime?    @map("courier_synced_at") @db.Timestamptz(3)
  /// The courier paid this parcel's COD to us ("Mark received" on Courier & COD).
  codSettledAt     DateTime?    @map("cod_settled_at") @db.Timestamptz(3)
  couponCode       String?      @map("coupon_code")
  /// Secret for the customer's confirmation link (/orders/<number>?t=<token>); null for POS/admin orders.
  accessToken      String?      @unique @map("access_token") @db.VarChar(64)
  subtotal         Int
  discount         Int          @default(0)
  /// Paid in advance (bKash/Nagad); cash to collect = total - advance.
  advance          Int          @default(0)
  shippingFee      Int          @default(0) @map("shipping_fee")
  total            Int
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTo    User?               @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recoveredFrom IncompleteCheckout? @relation(fields: [recoveredFromId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  notes         OrderNote[]
  events        OrderEvent[]

  @@index([phone])
  @@index([ipAddress])
  @@index([assignedToId])
  @@index([source])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([courierService, consignmentId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  productName  String   @map("product_name")
  /// Variant title at the time of the order ("size" in glowy).
  variantTitle String?  @map("variant_title")
  unitPrice    Int      @map("unit_price")
  quantity     Int
  lineTotal    Int      @map("line_total")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// BD Courier delivery history per phone ("fraud check"), reused for BDCOURIER_CACHE_HOURS.
model FraudCheck {
  id               String   @id @default(uuid(7)) @db.Uuid
  /// 01XXXXXXXXX
  phone            String   @unique @db.VarChar(20)
  totalParcels     Int      @default(0) @map("total_parcels")
  successParcels   Int      @default(0) @map("success_parcels")
  cancelledParcels Int      @default(0) @map("cancelled_parcels")
  /// 0-100; null when the number has no parcels yet
  successRatio     Int?     @map("success_ratio") @db.SmallInt
  /// [{ name, total, success, cancelled }] per courier
  couriers         Json?
  checkedAt        DateTime @map("checked_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fraud_checks")
}

/// Staff notes on an order (order panel "Notes" column), newest last.
model OrderNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  /// Name at the time of writing (kept if the staff account is removed).
  authorName String   @map("author_name") @db.VarChar(100)
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

/// Order activity ("Status changed to Confirmed by Rakib"), shown in the order's timeline.
model OrderEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorName String?  @map("actor_name") @db.VarChar(100)
  /// "status" | "created" | "edited" | "courier" | "assigned" | ...
  kind      String   @db.VarChar(30)
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Phone numbers and IPs that may not order (order panel "Blocked").
model BlockedContact {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// "phone" | "ip"
  kind        String   @db.VarChar(10)
  value       String   @db.VarChar(45)
  reason      String?  @db.VarChar(300)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([kind, value])
  @@map("blocked_contacts")
}

/// A checkout the shopper started (typed a valid phone) but did not finish ("Incomplete orders").
model IncompleteCheckout {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Random id kept in the shopper's browser, so typing again updates the same row.
  sessionKey  String    @unique @map("session_key") @db.VarChar(64)
  phone       String    @db.VarChar(20)
  name        String?   @db.VarChar(100)
  address     String?   @db.VarChar(500)
  district    String?   @db.VarChar(40)
  /// [{ productId, variantId, name, variantTitle, quantity, unitPrice }]
  items       Json
  value       Int       @default(0)
  /// Where they stopped, e.g. "Address", "District", "Place order"
  step        String    @db.VarChar(40)
  /// "new" (not contacted) | "called" | "recovered"
  state       String    @default("new") @db.VarChar(20)
  handledById String?   @map("handled_by_id") @db.Uuid
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(3)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  handledBy User?  @relation(fields: [handledById], references: [id], onDelete: SetNull)
  order     Order?

  @@index([state, createdAt])
  @@index([phone])
  @@map("incomplete_checkouts")
}

/// Store-wide settings edited in the admin (e.g. "security": order protection rules), as JSON per key.
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

/// Staff sign-in attempts (Fraud & security "Login history"). No passwords are stored.
model AdminLoginEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @db.VarChar(254)
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("admin_login_events")
}
