// Prisma schema — single source of truth for the database structure.
// Docs: docs/database-design.md
//
// Workflow:
//   development: pnpm db:migrate            (prisma migrate dev — creates + applies migrations)
//   production:  docker compose run --rm migrate   (prisma migrate deploy — applies committed migrations only)
// NEVER run `prisma migrate dev`, `migrate reset` or `db push` against production.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Catalog module (apps/backend/src/modules/catalog)
// Mirrors the glowy catalog schema; adds bundles + product relations used by the
// ehans-mart storefront design. Money columns are integer taka (BDT has no
// commonly used minor unit in this business; glowy stores whole taka too).
// =============================================================================

model Category {
  id              String   @id @default(uuid(7)) @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String
  slug            String   @unique
  homeTitle       String?  @map("home_title")
  image           String?
  description     String?
  position        Int      @default(0)
  showInMenu      Boolean  @default(true) @map("show_in_menu")
  homePosition    Int?     @map("home_position")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.VarChar(320)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    Product[]
  memberships ProductCategory[]

  @@index([parentId, position])
  @@index([homePosition])
  @@map("categories")
}

model Product {
  id               String   @id @default(uuid(7)) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  name             String
  slug             String   @unique
  sku              String   @unique
  brand            String?
  productType      String?  @map("product_type")
  /// Search keywords (e.g. English terms for Bangla product names).
  tags             String[] @default([])
  shortDescription String?  @map("short_description") @db.VarChar(500)
  /// Rich description (trusted HTML authored in the admin).
  description      String?
  /// [{ "label": "Brand", "value": "Mintiml" }, ...]
  specifications   Json?
  price            Int
  compareAtPrice   Int?     @map("compare_at_price")
  stock            Int      @default(0)
  soldCount        Int      @default(0) @map("sold_count")
  /// Denormalized from approved reviews (kept in sync by the reviews module).
  ratingAverage    Decimal? @map("rating_average") @db.Decimal(2, 1)
  ratingCount      Int      @default(0) @map("rating_count")
  isFeatured       Boolean  @default(false) @map("is_featured")
  isActive         Boolean  @default(true) @map("is_active")
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description") @db.VarChar(320)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  bundles     ProductBundle[]
  relations   ProductRelation[] @relation("ProductRelationSource")
  relatedTo   ProductRelation[] @relation("ProductRelationTarget")
  /// Collection memberships (many-to-many, like Shopify collections). `categoryId` is the
  /// primary category (breadcrumbs); listings filter by membership.
  collections ProductCategory[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([isActive, categoryId, price])
  @@index([isActive, isFeatured])
  @@index([brand])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  path      String
  alt       String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String   @db.VarChar(60)
  position  Int      @default(1) @db.SmallInt
  values    String[]
  /// Optional { "<value>": "#hex" | "/image/path" } for swatch pickers.
  swatches  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_options")
}

model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  imageId        String?  @map("image_id") @db.Uuid
  title          String   @default("Default Title") @db.VarChar(200)
  option1        String?  @db.VarChar(100)
  option2        String?  @db.VarChar(100)
  option3        String?  @db.VarChar(100)
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  costPerItem    Int?     @map("cost_per_item")
  sku            String?  @db.VarChar(80)
  barcode        String?  @db.VarChar(80)
  stock          Int      @default(0)
  weightGrams    Int?     @map("weight_grams")
  position       Int      @default(1) @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([productId, position])
  @@index([sku])
  @@map("product_variants")
}

/// Product ↔ collection membership with a manual sort position (collection order).
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

/// "Bundle & Save" tiers on the product page (buy N, save X%).
model ProductBundle {
  id              String   @id @default(uuid(7)) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int      @db.SmallInt
  title           String   @db.VarChar(80)
  discountPercent Int      @default(0) @map("discount_percent") @db.SmallInt
  badge           String?  @db.VarChar(60)
  freeDelivery    Boolean  @default(false) @map("free_delivery")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, quantity])
  @@map("product_bundles")
}

enum ProductRelationType {
  BUY_WITH
  UPSELL

  @@map("product_relation_type")
}

/// Merchandising links: "Buy it with" checkboxes and "Complete your ..." upsells.
model ProductRelation {
  id               String              @id @default(uuid(7)) @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  position         Int                 @default(0) @db.SmallInt
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  product        Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relations")
}

/// Product reviews from the storefront; shown only after an admin approves them.
model Review {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  name       String
  email      String?
  rating     Int      @db.SmallInt
  body       String
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
  @@index([isApproved, createdAt])
  @@map("reviews")
}

// =============================================================================
// Auth module (apps/backend/src/modules/auth) — admin users and their sessions.
// Same model as glowy: the store owner has every permission; staff get a map of
// { section: "view" | "manage" } (see AdminSection in @ehans/shared).
// =============================================================================

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  email        String?   @unique
  phone        String?   @unique @db.VarChar(20)
  passwordHash String    @map("password_hash")
  isAdmin      Boolean   @default(false) @map("is_admin")
  role         UserRole?
  /// { "orders": "manage", "products": "view", ... } — ignored for the owner.
  permissions  Json?
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  orders   Order[]

  @@map("users")
}

/// Admin sign-in sessions. Only a SHA-256 hash of the session token is stored.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// Orders (glowy's orders schema). Written by checkout / POS / admin (next slices);
// read by the admin dashboard now.
// =============================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@map("order_status")
}

/// Marketing channel that brought the customer (first touch), or POS.
enum OrderChannel {
  ORGANIC
  SOCIAL
  DIRECT
  REFERRAL
  POS

  @@map("order_channel")
}

model Order {
  id               String       @id @default(uuid(7)) @db.Uuid
  number           String       @unique @db.VarChar(40)
  userId           String?      @map("user_id") @db.Uuid
  status           OrderStatus  @default(PENDING)
  customerName     String       @map("customer_name")
  /// "walk-in" for anonymous POS sales.
  phone            String       @db.VarChar(30)
  email            String?
  address          String       @db.VarChar(500)
  city             String
  shippingZone     String       @map("shipping_zone")
  note             String?
  adminNote        String?      @map("admin_note")
  paymentMethod    String       @default("cod") @map("payment_method") @db.VarChar(30)
  paymentStatus    String?      @map("payment_status") @db.VarChar(20)
  paymentId        String?      @unique @map("payment_id") @db.VarChar(80)
  paymentAccount   String?      @map("payment_account") @db.VarChar(20)
  paymentReference String?      @map("payment_reference") @db.VarChar(40)
  channel          OrderChannel @default(DIRECT)
  ipAddress        String?      @map("ip_address") @db.VarChar(45)
  courier          String?
  trackingNumber   String?      @map("tracking_number")
  courierService   String?      @map("courier_service")
  consignmentId    String?      @map("consignment_id")
  courierStatus    String?      @map("courier_status")
  courierFee       Int?         @map("courier_fee")
  codAmount        Int?         @map("cod_amount")
  courierSentAt    DateTime?    @map("courier_sent_at") @db.Timestamptz(3)
  courierSyncedAt  DateTime?    @map("courier_synced_at") @db.Timestamptz(3)
  couponCode       String?      @map("coupon_code")
  subtotal         Int
  discount         Int          @default(0)
  shippingFee      Int          @default(0) @map("shipping_fee")
  total            Int
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([phone])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([courierService, consignmentId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  productName  String   @map("product_name")
  /// Variant title at the time of the order ("size" in glowy).
  variantTitle String?  @map("variant_title")
  unitPrice    Int      @map("unit_price")
  quantity     Int
  lineTotal    Int      @map("line_total")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
