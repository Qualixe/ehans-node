# Local development environment for the frontend (copy to apps/frontend/.env.local).

# Public API base URL used by the browser. Inlined at BUILD time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL (canonical links, metadata). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only: API base URL used by Server Components / Route Handlers.
# In Docker this is the internal service URL (http://backend:4000/api/v1).
# Read at RUNTIME. Defaults to NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=http://localhost:4000/api/v1
