{
  "name": "@ehans/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js storefront (App Router).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @ehans/shared build && next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "echo \"frontend: no unit tests yet (lint + typecheck + build are the gates)\""
  },
  "dependencies": {
    "@ehans/shared": "workspace:*",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "11.1.4",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
